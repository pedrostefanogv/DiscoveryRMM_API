{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Warning",
      "FluentMigrator": "Warning",
      "FluentMigrator.Runner": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HostOptions": {
    "BackgroundServiceExceptionBehavior": "Ignore"
  },
  "Authentication": {
    "Jwt": {
      "AccessTokenExpirationMinutes": 60,
      "RefreshTokenExpirationDays": 7,
      "MfaTokenExpirationMinutes": 3,
      "MfaSetupTokenExpirationMinutes": 10
    }
  },
  "Migrations": {
    "RunOnStartup": true
  },
  "Nats": {
    "Url": "nats://localhost:4222",
    "AuthUser": "discovery_nats",
    "AuthPassword": "",
    "AccountSeed": "",
    "XKeySeed": "",
    "AuthCallout": {
      "Enabled": true,
      "Subject": "$SYS.REQ.USER.AUTH"
    },
    "FanoutStream": {
      "Enabled": true,
      "Name": "DISCOVERY_FANOUT_COMMANDS",
      "Subjects": [
        "tenant.*.site.*.agents.command",
        "tenant.*.agents.command"
      ],
      "MaxAge": "24h",
      "MaxBytes": 134217728,
      "DuplicateWindow": "2m",
      "RetryDelaySeconds": 10,
      "MaxRetryAttempts": 12
    },
    "GlobalPong": {
      "OverloadMode": "auto",
      "PublishIntervalSeconds": 60,
      "ForcedValue": null,
      "WorkerThreadUsageThresholdPercent": 90,
      "ManagedMemoryUsageThresholdPercent": 85
    }
  },
  "Reporting": {
    "EnablePdf": true
  },
  "AppCatalog": {
    "Winget": {
      "Source": "manifests",
      "Enabled": true,
      "ManifestsPollIntervalMinutes": 60,
      "ClonePath": "/var/lib/discovery/winget-pkgs",
      "RepoUrl": "https://github.com/microsoft/winget-pkgs.git",
      "Branch": "master",
      "GitTimeoutSeconds": 900
    }
  },
  "RealtimeContract": {
    "Mode": "auto",
    "HardeningDateUtc": "2026-06-01T00:00:00Z"
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "discovery-api",
    "Protocol": "grpc",
    "OtlpEndpoint": "",
    "Headers": "",
    "MetricExportIntervalMilliseconds": 10000,
    "EnableHttpClientInstrumentation": true,
    "EnableRuntimeInstrumentation": true
  },
  "AutoTicket": {
    "Enabled": false,
    "ShadowMode": true,
    "ReopenWindowMinutes": 0,
    "MaxCreatedTicketsPerHourPerAlertCode": 0,
    "CanaryClientIds": [],
    "CanarySiteIds": []
  },
  "BackgroundJobs": {
    "KnowledgeEmbeddingEnabled": false,
    "KnowledgeEmbeddingQueueEnabled": true
  },
  "AutomaticLogging": {
    "Enabled": true,
    "MinimumLevel": "Info",
    "LogBusinessEvents": true,
    "LogExceptions": true
  },
  "AgentPackage": {
    "InstallerDefaults": {
      "DiscoveryEnabled": "1",
      "MinimalDefault": "1"
    },
    "GenericInstallerCacheMinutes": 30,
    "Profiles": {
      "linux": {
        "DiscoveryProjectPath": "/opt/discovery-agent-src",
        "BinaryPath": "/opt/discovery-agent-src/src/build/bin/discovery-agent.exe",
        "OutputName": "discovery-agent.exe"
      },
      "windows": {
        "DiscoveryProjectPath": "C:\\Discovery",
        "BinaryPath": "C:\\Discovery\\src\\build\\bin\\discovery-agent.exe",
        "OutputName": "discovery-agent.exe"
      }
    }
  },
  "RemoteAccess": {
    "Enabled": true,
    "DefaultTtlMinutes": 30,
    "MaxConcurrentSessionsPerAgent": 1,
    "MaxConcurrentSessionsPerUser": 5,
    "Nats": {
      "MaxPayloadBytes": 2097152,
      "FrameSubjectPrefix": "remote.session"
    },
    "WebRtc": {
      "Enabled": true,
      "StunUrls": [
        "stun:stun.l.google.com:19302"
      ],
      "TurnUrls": [],
      "TurnCredentialTtlMinutes": 60,
      "IceTimeoutSeconds": 5
    },
    "Proxy": {
      "DefaultAllowlist": [],
      "AllowedPorts": [],
      "MaxResponseBytes": 10485760
    },
    "Quality": {
      "DefaultProfile": "high",
      "AdaptiveEnabled": true,
      "MinFps": 5,
      "MaxFps": 30,
      "DefaultCodec": "auto"
    },
    "Recording": {
      "Enabled": true,
      "DefaultOn": false,
      "StorageProvider": "Local",
      "Local": {
        "BasePath": "/var/discovery/recordings",
        "MaxDiskUsageGb": 50
      },
      "S3": {
        "Endpoint": "https://s3.amazonaws.com",
        "Bucket": "discovery-rmm-recordings",
        "Region": "us-east-1",
        "AccessKey": "",
        "SecretKey": "",
        "UsePathStyle": false,
        "PresignTtlMinutes": 15
      },
      "Retention": {
        "DefaultDays": 30,
        "MaxDays": 90,
        "AutoDeleteExpired": true
      },
      "Format": {
        "Container": "Auto",
        "VideoCodec": "Source"
      }
    }
  }
}