{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
      "Microsoft.EntityFrameworkCore.Migrations": "Warning",
      "FluentMigrator": "Warning",
      "FluentMigrator.Runner": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HostOptions": {
    "BackgroundServiceExceptionBehavior": "StopHost"
  },
  "Authentication": {
    "Jwt": {
      "AccessTokenExpirationMinutes": 60,
      "RefreshTokenExpirationDays": 7,
      // 3 min era apertado para o fluxo híbrido (QR + biometria no celular): o token
      // mfa_pending expirava no meio da cerimônia. 5 min é o valor recomendado na
      // investigação do Android (RELATORIO_MFA_FIDO2_ANDROID_2026-11-01.md, correção 2).
      "MfaTokenExpirationMinutes": 5,
      "MfaSetupTokenExpirationMinutes": 30
    },
    "Fido2": {
      // RP ID: domínio exato da aplicação (não é a origem — sem esquema e sem porta).
      "ServerDomain": "localhost",
      "ServerName": "Discovery RMM",
      // Origens aceitas no clientDataJSON. Devem ser ajustadas por ambiente
      // (ex.: https://discovery.exemplo.com.br).
      "Origins": [
        "https://localhost",
        "http://localhost",
        "https://localhost:5001",
        "http://localhost:5001"
      ],
      // Timeout (ms) do challenge anunciado ao cliente WebAuthn. O default da lib era
      // 60 s e estourava no fluxo híbrido do Android (QR + BLE); 120 s dá folga.
      "TimeoutMilliseconds": 120000,
      // TTL do challenge no Redis. Precisa cobrir o timeout anunciado, com folga para a
      // requisição de complete chegar. O mínimo aplicado em código é 180 s.
      "ChallengeTtlSeconds": 300
    }
  },
  "Push": {
    "Enabled": true,
    "VapidPublicKey": "",
    "VapidPrivateKey": "",
    "VapidSubject": "mailto:suporte@discovery.local",
    "MaxSubscriptionsPerUser": 20,
    "TtlSeconds": 3600,
    "HttpTimeoutSeconds": 10,
    "BatchTimeoutSeconds": 15,
    "AllowDevelopmentKeyGeneration": true
  },
  "Migrations": {
    "RunOnStartup": true
  },
  "Nats": {
    "Url": "nats://localhost:4222",
    "AuthUser": "discovery_nats",
    "AuthPassword": "",
    "AccountSeed": "",
    "XKeySeed": "",
    "AuthCallout": {
      "Enabled": true,
      "Subject": "$SYS.REQ.USER.AUTH"
    },
    "FanoutStream": {
      "Enabled": true,
      "Name": "DISCOVERY_FANOUT_COMMANDS",
      "Subjects": [
        "tenant.*.site.*.agents.command",
        "tenant.*.agents.command"
      ],
      "MaxAge": "24h",
      "MaxBytes": 134217728,
      "DuplicateWindow": "2m",
      "RetryDelaySeconds": 10,
      "MaxRetryAttempts": 12
    },
    "CommandRedelivery": {
      "Enabled": true,
      "IntervalSeconds": 120,
      "MinAgeSeconds": 120,
      "RetryGraceSeconds": 300,
      "RetentionHours": 24,
      "BatchSize": 200
    },
    "GlobalPong": {
      "OverloadMode": "auto",
      "PublishIntervalSeconds": 60,
      "ForcedValue": null,
      "WorkerThreadUsageThresholdPercent": 90,
      "ManagedMemoryUsageThresholdPercent": 85
    },
    "SupportChatStream": {
      "Enabled": true,
      "Name": "DISCOVERY_SUPPORT_CHAT",
      "Subjects": [
        "tenant.*.site.*.agent.*.supportchat.*"
      ],
      "MaxAge": "24h",
      "MaxBytes": 268435456,
      "DuplicateWindow": "2m",
      "RetryDelaySeconds": 10,
      "MaxRetryAttempts": 12
    }
  },
  "TicketChat": {
    "InviteTimeoutSeconds": 120,
    "InactivityTimeoutMinutes": 30,
    "MaxMessageLength": 8192,
    "MaxAttachmentsPerMessage": 10,
    "MaxHistoryPageSize": 100,
    "InviteRetryCooldownSeconds": 30,
    "NotifySupportOnMessage": true
  },
  "AppCatalog": {
    "Winget": {
      "Source": "manifests",
      "Enabled": true,
      "ManifestsPollIntervalMinutes": 360,
      "StartupSyncDelayMinutes": 2,
      "MaxParseParallelism": 0,
      "ClonePath": "/var/lib/discovery-api/winget-pkgs",
      "RepoUrl": "https://github.com/microsoft/winget-pkgs.git",
      "Branch": "master",
      "GitTimeoutSeconds": 900
    }
  },
  "RealtimeContract": {
    "Mode": "auto",
    "HardeningDateUtc": "2026-06-01T00:00:00Z"
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "discovery-api",
    "Protocol": "grpc",
    "OtlpEndpoint": "",
    "Headers": "",
    "MetricExportIntervalMilliseconds": 10000,
    "EnableHttpClientInstrumentation": true,
    "EnableRuntimeInstrumentation": true
  },
  "AutoTicket": {
    "Enabled": false,
    "ShadowMode": true,
    "ReopenWindowMinutes": 0,
    "MaxCreatedTicketsPerHourPerAlertCode": 0,
    "CanaryClientIds": [],
    "CanarySiteIds": []
  },
  "Tickets": {
    "DepartmentAuth": {
      // Autorizacao por departamento/time de atendimento.
      //
      // true  = MODO OBSERVACAO: as negacoes de tratar/fechar sao registradas em
      //         log (SHADOW departamento: ...) mas o acesso e concedido. Serve
      //         para medir quem seria barrado ANTES de ligar a regra.
      // false = REGRA ATIVA: somente o time do departamento trata/atende os
      //         chamados; quem abriu so pode encerrar o proprio.
      //
      // Padrao true porque papeis existentes (Operator, Support) tem Tickets.Edit
      // amplo e seriam bloqueados de imediato. Popule os times dos departamentos
      // e acompanhe o log antes de definir como false.
      "ShadowMode": true
    }
  },
  "BackgroundJobs": {
    // Kill switch REAL do KnowledgeEmbeddingJob (re-chunking + embeddings em
    // lote + fila LISTEN/NOTIFY). Antes o job era agendado incondicionalmente e
    // esta chave não era lida por ninguém. Default true = comportamento atual.
    // Use false para não agendar o job. Toggle herdável por cliente/site:
    // ServerConfiguration.KnowledgeEmbeddingEnabled.
    "KnowledgeEmbeddingEnabled": true,
    // LEGADO: o job unificado já consome a fila; chave mantida apenas para
    // compatibilidade (não é lida por nenhum agendamento).
    "KnowledgeEmbeddingQueueEnabled": true,
    "TicketAnswerEmbedding": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "StartupDelaySeconds": 20
    }
  },
  "AutomaticLogging": {
    "Enabled": true,
    "MinimumLevel": "Info",
    "LogBusinessEvents": true,
    "LogExceptions": true
  },
  "AgentPackage": {
    "InstallerDefaults": {
      "DiscoveryEnabled": "1",
      "MinimalDefault": "1"
    },
    "GenericInstallerCacheMinutes": 30,
    "Profiles": {
      "linux": {
        "DiscoveryProjectPath": "/opt/discovery-agent-src",
        "BinaryPath": "/opt/discovery-agent-src/src/build/bin/discovery-agent.exe",
        "OutputName": "discovery-agent.exe"
      },
      "windows": {
        "DiscoveryProjectPath": "C:\\Discovery",
        "BinaryPath": "C:\\Discovery\\src\\build\\bin\\discovery-agent.exe",
        "OutputName": "discovery-agent.exe"
      }
    }
  },
  "RemoteDebug": {
    "DefaultTtlMinutes": 20,
    "MinTtlMinutes": 2,
    "MaxTtlMinutes": 120,
    "MaxSessionDurationMinutes": 60,
    "PingIntervalSeconds": 5,
    "MissedPingsBeforeClose": 3,
    "InitialGraceSeconds": 60,
    "KeepAliveSeconds": 60,
    "KeepAliveTimeoutSeconds": 300
  },
  "RemoteAccess": {
    "Enabled": true,
    "DefaultTtlMinutes": 30,
    "MaxSessionDurationMinutes": 60,
    "MaxConcurrentSessionsPerAgent": 1,
    "MaxConcurrentSessionsPerUser": 5,
    "OrphanedSessionGraceSeconds": 120,
    "Liveness": {
      "PingIntervalSeconds": 5,
      "MissedPingsBeforeClose": 3,
      "InitialGraceSeconds": 60,
      "KeepAliveTimeoutSeconds": 300,
      "SweepIntervalSeconds": 15
    },
    "Consent": {
      "MinimumAgentVersion": "1.3.0",
      "DecisionGraceSeconds": 30,
      "LateDecisionGraceSeconds": 15
    },
    "Nats": {
      "MaxPayloadBytes": 2097152,
      "FrameSubjectPrefix": "remote.session"
    },
    "Proxy": {
      "DefaultAllowlist": [],
      "AllowedPorts": [],
      "MaxResponseBytes": 10485760
    },
    "Quality": {
      "DefaultProfile": "high",
      "AdaptiveEnabled": true,
      "MinFps": 5,
      "MaxFps": 30,
      "DefaultCodec": "auto"
    },
    "Recording": {
      "Enabled": true,
      "DefaultOn": false,
      "StorageProvider": "Local",
      "Local": {
        "BasePath": "/var/discovery/recordings",
        "MaxDiskUsageGb": 50
      },
      "S3": {
        "Endpoint": "https://s3.amazonaws.com",
        "Bucket": "discovery-rmm-recordings",
        "Region": "us-east-1",
        "AccessKey": "",
        "SecretKey": "",
        "UsePathStyle": false,
        "PresignTtlMinutes": 15
      },
      "Retention": {
        "DefaultDays": 30,
        "MaxDays": 90,
        "AutoDeleteExpired": true
      },
      "Format": {
        "Container": "Auto",
        "VideoCodec": "Source"
      }
    }
  },
  "Tickets": {
    "CategoryOptions": [
      "Hardware",
      "Software",
      "Rede",
      { "value": "Acesso", "label": "Acesso / Permissões" },
      { "value": "Email", "label": "E-mail" },
      "Impressora",
      "VPN",
      "Outro"
    ]
  }
}