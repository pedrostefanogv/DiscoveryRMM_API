# Copie para discovery-install.env e ajuste os valores.
# Uso:
#   chmod 600 discovery-install.env
#   ./scripts/linux/install_discovery_server.sh --config ./discovery-install.env --non-interactive

# Update do servidor: SEMPRE manual, executado pelo administrador via
#   ./scripts/linux/install_discovery_server.sh --mode update
# (ou a opcao 3 do bootstrap). Nao existe self-update automatico.
# Opcional: atualizar tambem os pacotes do SO durante o update manual
# (apt-get upgrade; lento e pode restartar servicos de infra).
DISCOVERY_APPLY_SYSTEM_UPDATES="0"

# npm: o pacote do Node 22 traz npm 10.x. Depois de instalar/validar o Node, o
# instalador roda `npm install -g npm@<valor>`. Vazio = "latest".
# Fixe uma major ou versao exata para reprodutibilidade (ex.: "12", "12.2.0").
DISCOVERY_NPM_VERSION=""

# Repositorios
DISCOVERY_GIT_REPO="https://github.com/pedrostefanogv/DiscoveryRMM_API"
DISCOVERY_AGENT_GIT_REPO="https://github.com/pedrostefanogv/DiscoveryRMM_Agent"
DISCOVERY_SITE_GIT_REPO="https://github.com/pedrostefanogv/DiscoveryRMM_Site"
DISCOVERY_GIT_BRANCH="release"
# Canal sugerido: lts | release | beta | dev
# Se DISCOVERY_GIT_BRANCH estiver vazio no modo interativo, o instalador pergunta o canal.
# DISCOVERY_RELEASE_CHANNEL opcional para compatibilidade (mesmo valor de branch).
DISCOVERY_RELEASE_CHANNEL=""

# Token GitHub (bootstrap). Use apenas se o repositorio for privado.
# Use token temporario e rotacione apos instalar.
GITHUB_PAT=""

# Execucao:
# - rode como root; ou
# - rode com um usuario que tenha sudo funcional (ex.: execute `sudo -v` antes).
#
# Usuario instalador (com sudo): quando o instalador roda como root, ele cria
# ou reutiliza um usuario comum e reexecuta a instalacao como esse usuario,
# para a instalacao nao ficar presa ao root. No modo interativo o nome e a
# senha sao solicitados (a senha tambem e a senha do sudo). No modo
# --non-interactive, definir DISCOVERY_INSTALL_USER_PASSWORD ativa o fluxo;
# sem ela o instalador segue como root.
DISCOVERY_INSTALL_USER="discovery"
DISCOVERY_INSTALL_USER_PASSWORD=""

# Acesso: internal | external | hybrid
ACCESS_MODE="internal"
INTERNAL_API_HOST="api.interno.local"
EXTERNAL_API_HOST=""
# Token do Cloudflare Tunnel. Pode ser o token puro (comeca com "eyJ") ou o
# comando completo do painel (cloudflared ... --token eyJ...): o instalador
# extrai o token automaticamente.
CLOUDFLARE_TUNNEL_TOKEN=""

# TLS do Nginx: self-signed | zerossl-acme | letsencrypt-acme
# zerossl-acme e letsencrypt-acme usam DNS-01 manual: o instalador exibe o registro TXT,
# pede confirmacao e valida com dig antes de prosseguir. Para automacao completa depois,
# informe um hook (ex.: cloudflare-dns-hook.sh).
# Renovacao recomendada: timer diario, tentando renovar quando faltar ate 30 dias.
TLS_CERT_PROVIDER="self-signed"

# ── ZeroSSL (requer EAB KID + HMAC) ────────────────────────────────────────
ZEROSSL_CERT_DOMAIN=""
ZEROSSL_CERT_ALT_DOMAINS=""
ZEROSSL_ACME_EMAIL=""
ZEROSSL_ACME_EAB_KID=""
ZEROSSL_ACME_EAB_HMAC_KEY=""
ZEROSSL_DNS_RESOLVERS="1.1.1.1,8.8.8.8"
ZEROSSL_DNS_PROPAGATION_TIMEOUT_SECONDS="600"
ZEROSSL_DNS_POLL_INTERVAL_SECONDS="15"
ZEROSSL_RENEW_DAYS_BEFORE_EXPIRY="30"
ZEROSSL_AUTO_RENEW_ENABLED="1"
ZEROSSL_DNS_AUTOMATION_HOOK=""

# ── Let's Encrypt (nao requer EAB, apenas email) ──────────────────────────
LETSENCRYPT_CERT_DOMAIN=""
LETSENCRYPT_CERT_ALT_DOMAINS=""
LETSENCRYPT_ACME_EMAIL=""
LETSENCRYPT_DNS_RESOLVERS="1.1.1.1,8.8.8.8"
LETSENCRYPT_DNS_PROPAGATION_TIMEOUT_SECONDS="600"
LETSENCRYPT_DNS_POLL_INTERVAL_SECONDS="15"
LETSENCRYPT_RENEW_DAYS_BEFORE_EXPIRY="30"
LETSENCRYPT_AUTO_RENEW_ENABLED="1"
LETSENCRYPT_DNS_AUTOMATION_HOOK=""

# OpenAPI/Scalar
# OpenAPI publica o contrato da API em /openapi/{versao}.json (rota anonima).
# 1 = habilitado, 0 = desativado. Padrao seguro em producao: 0.
OPENAPI_ENABLED="0"
# Opcional: controla apenas a UI interativa do Scalar (/scalar), que consome o
# contrato OpenAPI e inclui o console "Try it out" — tambem anonima.
# Em producao o padrao e 0; vazio = segue OPENAPI_ENABLED.
OPENAPI_SCALAR_ENABLED=""

# Banco
POSTGRES_DB="discovery"
POSTGRES_USER="discovery_app"
POSTGRES_PASSWORD="troque-esta-senha"

# NATS
# Deixe vazio para gerar automaticamente no instalador.
NATS_USER=""
NATS_PASSWORD=""
# Vazio = reutiliza o usuario/senha NATS gerados ou informados acima.
NATS_AUTH_USER=""
NATS_AUTH_PASSWORD=""
NATS_BIND_HOST="0.0.0.0"
NATS_MONITOR_HOST="127.0.0.1"
# Aceita y/n (ou 1/0). y/1 = habilitado (padrao), n/0 = desativado.
NATS_AUTH_CALLOUT_ENABLED="1"
NATS_AUTH_CALLOUT_SUBJECT="\$SYS.REQ.USER.AUTH"
# NATS WebSocket local para browsers via Nginx (/nats/)
NATS_WS_PORT="8081"
NATS_WS_HOST="127.0.0.1"
NATS_WS_TLS_ENABLED="false"
# Host NATS externo para agents (DNS/IP publico)
# Vazio = reutiliza o host da API.
NATS_SERVER_HOST_EXTERNAL=""
# Host NATS interno para API (normalmente 127.0.0.1)
NATS_SERVER_HOST_INTERNAL="127.0.0.1"
# Usar WSS (WebSocket + TLS) para agents externos
NATS_USE_WSS_EXTERNAL="false"

# JetStream (persistencia + replay de comandos fan-out)
NATS_JS_ENABLED="1"
# Recomendado manter dentro de /opt/discovery-ops para facilitar backup/operacao.
NATS_JS_STORE_DIR="/opt/discovery-ops/nats/jetstream"
NATS_JS_MAX_MEMORY_STORE="64M"
NATS_JS_MAX_FILE_STORE="512M"

# Bootstrap automatico do stream de fan-out
NATS_JS_FANOUT_STREAM_ENABLED="1"
NATS_JS_FANOUT_STREAM_NAME="DISCOVERY_FANOUT_COMMANDS"
NATS_JS_FANOUT_STREAM_SUBJECTS="tenant.*.site.*.agents.command,tenant.*.agents.command"
# TTL de retenção no stream (replay)
NATS_JS_FANOUT_STREAM_MAX_AGE="24h"
# Limite total do stream em bytes
NATS_JS_FANOUT_STREAM_MAX_BYTES="134217728"
# Janela de deduplicacao no broker
NATS_JS_FANOUT_STREAM_DUPE_WINDOW="2m"

# Caminhos
DISCOVERY_API_BASE="/opt/discovery-api"
DISCOVERY_SITE_BASE="/opt/discovery-site"
DISCOVERY_AGENT_SRC="/opt/discovery-agent-src"
DISCOVERY_AGENT_ARTIFACTS="/opt/discovery-agent-artifacts"
DISCOVERY_OPS_DIR="/opt/discovery-ops"

# Portal web
# Vazio = mesma origem do Nginx (recomendado)
DISCOVERY_SITE_API_URL=""
# Opcoes: signalr | nats | both
# Padrao recomendado do instalador: NATS primario com fallback SignalR
DISCOVERY_SITE_REALTIME_PROVIDER="both"
DISCOVERY_SITE_NATS_ENABLED="true"
# Vazio = o instalador publica wss://<host>/nats/ para o browser.
DISCOVERY_SITE_NATS_URL=""
# Janela de offline do agente (ms). Se vazio, usa 60000.
DISCOVERY_SITE_AGENT_OFFLINE_FALLBACK_MS=""

# ── Web Push (notificações do navegador) ───────────────────────────────────
# Deixe VAZIO: o instalador gera um par VAPID na primeira instalação e o
# PRESERVA nos updates — trocar as chaves invalida todas as inscrições de
# navegador existentes. Preencha apenas para trazer um par próprio (ex.:
# restaurado de backup).
# O par fica em /etc/discovery-api/discovery.env, junto com o resto da
# configuração — o backup do env leva as chaves junto.
PUSH_VAPID_PUBLIC_KEY=""
PUSH_VAPID_PRIVATE_KEY=""
# Contato exigido pelos provedores de push (mailto: ou https:).
# Vazio = mailto:suporte@<domínio do servidor>.
PUSH_VAPID_SUBJECT=""
# 1 = Web Push habilitado, 0 = desabilitado.
PUSH_ENABLED="1"

# ── Sessões remotas (debug remoto e acesso remoto nativo) ──────────────────
# Duração máxima (em horas) que uma sessão remota se mantém sem precisar
# reconectar. Enquanto o viewer estiver saudável (ping-pong), a sessão se
# renova sozinha; ao atingir este teto ela é encerrada.
# Padrão: 1 (uma hora). Aceita inteiro entre 1 e 24.
REMOTE_SESSION_MAX_DURATION_HOURS="1"

# Dotnet publish da API (autodetect quando vazio)
# Opcoes suportadas nesta fase: linux-x64 | linux-arm64
# Em host ARM64, deixe vazio ou defina linux-arm64 explicitamente.
DISCOVERY_DOTNET_RUNTIME=""

# MFA/FIDO2 + CORS
# Para ambiente local sem DNS publico, use um hostname interno consistente quando possivel.
# Se vazio, o instalador tenta derivar do host interno/externo.
# Se o valor derivado for um IP, o instalador converte automaticamente para <ip-com-hifen>.nip.io.
DISCOVERY_FIDO2_SERVER_DOMAIN=""
DISCOVERY_FIDO2_SERVER_NAME="Discovery RMM"

# Origens adicionais (separadas por virgula) para CORS/FIDO2, ex:
# DISCOVERY_ADDITIONAL_ALLOWED_ORIGINS="https://painel.local,https://192.168.1.131:8443"
DISCOVERY_ADDITIONAL_ALLOWED_ORIGINS=""

# ── Storage de arquivos (anexos/prints) ────────────────────────────────────
# O instalador pergunta isso no wizard; aqui ficam os valores para o modo
# --config/--non-interactive.
#
# DISCOVERY_OBJECT_STORAGE_MODE:
#   rustfs   - instala o RustFS LOCAL nesta maquina e grava a configuracao no banco (default)
#   external - usa um S3-compativel ja existente (R2/S3/MinIO/...)
#   skip     - nao instala e nao altera nada (configuravel depois)
# No wizard, apertar Enter seleciona rustfs; digitar 3 adia a configuracao.
# No modo --non-interactive, sem esta variavel o default tambem e rustfs; use
# "skip" explicitamente para nao instalar/alterar nada.
DISCOVERY_OBJECT_STORAGE_MODE="rustfs"

# Nome do bucket (o caminho do bucket e publicado pelo nginx no mesmo host).
DISCOVERY_OBJECT_STORAGE_BUCKET="discovery-files"

# Endpoint do storage: apenas host[:porta] ou http(s)://host[:porta], SEM path.
# Um path quebraria a assinatura das URLs pre-assinadas (o proprio backend valida).
# RustFS: deixe vazio para o instalador derivar o host do portal (https://<dominio>).
DISCOVERY_OBJECT_STORAGE_ENDPOINT=""
DISCOVERY_OBJECT_STORAGE_REGION="us-east-1"

# Credenciais. Com RustFS e vazio, o instalador gera e guarda em /etc/default/rustfs
# (modo 600) e reutiliza em reexecucoes (NAO rotaciona). Para provedor externo,
# preencha access/secret.
DISCOVERY_OBJECT_STORAGE_ACCESS_KEY=""
DISCOVERY_OBJECT_STORAGE_SECRET_KEY=""

# path-style: true para RustFS/MinIO/R2. SSL verify: true em producao.
DISCOVERY_OBJECT_STORAGE_USE_PATH_STYLE="true"
DISCOVERY_OBJECT_STORAGE_SSL_VERIFY="true"
DISCOVERY_OBJECT_STORAGE_URL_TTL_HOURS="24"

# RustFS local: porta em loopback, publicacao pelo nginx e limite de upload do
# location (client_max_body_size).
DISCOVERY_OBJECT_STORAGE_PORT="9000"
DISCOVERY_OBJECT_STORAGE_NGINX_ENABLED="y"
DISCOVERY_OBJECT_STORAGE_MAX_UPLOAD="500m"

# Versao do RustFS: FIXA e sem auto-update (o instalador so avisa se differir).
RUSTFS_VERSION="1.0.1"
RUSTFS_ADDRESS="127.0.0.1:9000"
RUSTFS_DATA_DIR="/opt/rustfs/data"
# sha256 do pacote do RustFS (opcional, recomendado): se preenchido, o download
# e verificado e o deploy falha quando divergir. Vazio = apenas avisa e mostra
# o sha256 obtido para voce fixar aqui depois.
RUSTFS_SHA256=""

# 1 = testa a conexao/bucket depois de gravar (default). 0 = somente grava.
DISCOVERY_OBJECT_STORAGE_TEST="1"
# 1 = regrava a configuracao do object storage mesmo sem mudanca (env + banco) e
# sobrescreve um segredo ja configurado. O update normal e idempotente: com 0
# nada e regravado quando os valores ja estao iguais. No servidor tambem existe
# a opcao 8 do menu "Manutencao avancada" para forcar quando necessario.
DISCOVERY_OBJECT_STORAGE_FORCE="0"
